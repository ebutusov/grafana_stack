# Copy to ".env" and change every secret. Do not commit .env.
TZ=Europe/Warsaw

# Image tags - pin to exact versions for production
INFLUXDB_TAG=2.7
GRAFANA_TAG=latest
NODERED_TAG=latest-22

# Gateway (nginx) - the only published host port. Set GATEWAY_BIND=127.0.0.1 to keep it local.
#GATEWAY_BIND=0.0.0.0
#GATEWAY_PORT=80

# InfluxDB (initial setup only - changing these after first start does not alter an existing volume)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me
INFLUX_ORG=myorg
INFLUX_BUCKET=telemetry
INFLUX_RETENTION=0
# Generate e.g. with: openssl rand -hex 32
INFLUX_TOKEN=change-me-openssl-rand-hex-32

# Node-RED
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD=change-me
# Encrypts stored credentials. Generate once, then never change it. e.g. openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=change-me-openssl-rand-hex-32
# Starter flow: Modbus/TCP device to poll and the value of the "device" tag
MODBUS_HOST=192.168.1.100
DEVICE_NAME=plc1

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
